# AfiaCare local AI configuration
# Optimized defaults for low-spec CPU machines such as Dell Latitude E5440 / 8 GB RAM.
#
# Text chat / planning:
# LM Studio local server, OpenAI-compatible mode.
LOCAL_LLM_PROVIDER=openai
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=lm-studio
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct
LOCAL_LLM_NUM_CTX=1024
LOCAL_LLM_MAX_TOKENS=160
LOCAL_LLM_MAX_MESSAGES=5
LOCAL_LLM_MAX_PROMPT_CHARS=2800
LOCAL_LLM_TEMPERATURE=0.25
LOCAL_LLM_NUM_THREAD=2
LOCAL_LLM_KEEP_ALIVE=0
LOCAL_LLM_TIMEOUT_MS=45000
LOCAL_WELLNESS_TIMEOUT_MS=50000
LOCAL_THERAPIST_TIMEOUT_MS=50000
LOCAL_FOOD_REASONING_MAX_TOKENS=260
LOCAL_FOOD_REASONING_MAX_PROMPT_CHARS=1700
LOCAL_FOOD_REASONING_TIMEOUT_MS=12000

# Alternative: llama.cpp / another OpenAI-compatible local server
# LOCAL_LLM_PROVIDER=openai
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=

# Computer vision:
# Food photo and posture correction can share one endpoint, or use separate endpoints.
# The endpoint should accept JSON with imageDataUrl, image, kind, prompt, and optional pose.
LOCAL_CV_URL=http://127.0.0.1:7860/analyze

# Food photos can run directly through LM Studio SmolVLM.
LOCAL_FOOD_VISION_PROVIDER=lmstudio
LOCAL_FOOD_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_FOOD_VISION_API_KEY=lm-studio
LOCAL_FOOD_VISION_MODEL=smolvlm-500m-instruct
LOCAL_FOOD_VISION_NUM_CTX=1024
LOCAL_FOOD_VISION_MAX_TOKENS=220
LOCAL_FOOD_VISION_NUM_THREAD=2
LOCAL_FOOD_VISION_KEEP_ALIVE=0
LOCAL_FOOD_VISION_TIMEOUT_MS=60000

# Optional separate CV endpoints:
# LOCAL_FOOD_VISION_URL=http://127.0.0.1:7860/food
# LOCAL_POSTURE_URL=http://127.0.0.1:7860/posture
# LOCAL_CV_API_KEY=
LOCAL_CV_TIMEOUT_MS=12000

# If true, food analysis fails instead of falling back to cloud AI when local CV is unavailable.
LOCAL_CV_REQUIRED=false

# Optional OpenAI cloud fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
